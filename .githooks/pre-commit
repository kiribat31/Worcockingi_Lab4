#!/bin/sh

# Запрещённые папки
BLOCKED_DIRS="Saved Intermediate Binaries DerivedDataCache .vs"

# Проверяем добавленные файлы
FILES=$(git diff --cached --name-only --diff-filter=ACMR)

for FILE in $FILES; do
    for DIR in $BLOCKED_DIRS; do
        case "$FILE" in
            "$DIR"/*|*/"$DIR"/*)
                echo "ОШИБКА: Нельзя коммитить файлы из папки $DIR: $FILE"
                exit 1
                ;;
        esac
    done

    # Проверяем размер файла
    if [ -f "$FILE" ]; then
        SIZE=$(wc -c < "$FILE")

        if [ "$SIZE" -gt 52428800 ]; then
            FILTER=$(git check-attr filter -- "$FILE" | sed 's/.*: //')

            if [ "$FILTER" != "lfs" ]; then
                echo "ОШИБКА: Файл больше 50 МБ и не отслеживается Git LFS: $FILE"
                exit 1
            fi
        fi
    fi
done

echo "Проверка pre-commit пройдена!"
exit 0